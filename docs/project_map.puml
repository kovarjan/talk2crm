@startuml talk2crm_architecture_narrow_with_deprecated_domain

!theme plain

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam packageStyle rectangle
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #555555
  FontColor #555555
}
skinparam component {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
}
skinparam database {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
}
skinparam cloud {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
}
skinparam ArrowColor #000000
skinparam ArrowFontColor #000000
skinparam NoteBackgroundColor #EEEEEE
skinparam NoteBorderColor #000000
skinparam linetype ortho
skinparam nodesep 20
skinparam ranksep 20

top to bottom direction

' title talk2crm – Architektura systému

actor "Klient\n(Coripo UI)" as Client

rectangle "FastAPI aplikace" as APP {

  ' --- LEVÝ SLOUPEC ---
  rectangle "API vrstva (app/api/)" as API #FAFAFA {
    component "endpoints.py" as EP
    component "dependencies.py" as DEP
    component "models.py" as API_MODELS

    EP --> DEP
    DEP --> API_MODELS
  }

  rectangle "Engine vrstva (app/engine/)" as ENG #FAFAFA {
    component "agent.py" as AGT
    component "tools.py" as TLS
    component "quick_actions.py" as QA
    component "adjustments.py" as ADJ
    component "filter_builder.py" as FB
    component "rag.py" as RAG

    AGT --> TLS
    TLS --> QA
    QA --> ADJ
    ADJ --> FB
    FB --> RAG
  }

  rectangle "Domain a NLU\n(Vyřazeno z produkce)" as DOM #FAFAFA;line.dashed;text:gray {
    component "entity_resolver.py" as ER #FFFFFF;line.dashed;text:gray
    component "temporal_resolver.py" as TR #FFFFFF;line.dashed;text:gray
    component "contracts.py" as CON #FFFFFF;line.dashed;text:gray
    component "command_parser.py" as CP #FFFFFF;line.dashed;text:gray

    ER -[hidden]down-> TR
    TR -[hidden]down-> CON
    CON -[hidden]down-> CP
  }

  ' --- PRAVÝ SLOUPEC ---
  rectangle "Core a prezentace" as CORE #FAFAFA {
    component "config.py + security.py" as CFG
    component "audio.py" as AUD
    component "cards.py" as CRD

    CFG -[hidden]down-> AUD
    AUD -[hidden]down-> CRD
  }

  rectangle "Služby (app/services/)" as SVC #FAFAFA {
    component "tenant_manager.py" as TM
    component "crm_client.py" as CC
    component "crm_write_service.py" as WS
    component "crm_read_service.py" as RS

    TM --> CC
    CC --> WS
    WS --> RS
  }

  rectangle "Datová vrstva (database/)" as DB #FAFAFA {
    component "models.py" as DBM
    component "session.py" as DBS

    DBM --> DBS
  }

  ' --- VYNUCENÍ PEVNÉ MŘÍŽKY ---
  ' Vertikální sloupce
  API -[hidden]down-> ENG
  ENG -[hidden]down-> DOM

  CORE -[hidden]down-> SVC
  SVC -[hidden]down-> DB

  ' Horizontální zarovnání řad (zabrání plavání prázdného bloku DOM)
  API -[hidden]right-> CORE
  ENG -[hidden]right-> SVC
  DOM -[hidden]right-> DB
}

' Externí komponenty zarovnané dole pod aplikací
database "Qdrant\n(kolekce)" as QD
database "PostgreSQL" as PG
cloud "Coripo CRM\nREST API" as CRM
cloud "LLM endpoint\n(Qwen/Ollama)" as LLM

' --- Externí vstup ---
Client --> EP : HTTP\nX-Tenant,\nX-User-Id

' --- Propojky mezi sloupci a vnitřní toky ---
' Z API do zbytku
EP --> AGT
EP --> QA
EP -right-> AUD
DEP -right-> CFG
DEP --> TM

' Z Engine do zbytku
TLS -right-> WS
TLS -right-> RS
TLS --> RAG
TLS --> FB
TLS --> CRD

QA -right-> WS

' Ze Services (křížové vazby zpět do levého sloupce)
WS -left-> ADJ
WS -left-> RAG
RS -left-> FB

' Z DB vrstvy
TM --> DBS

' --- Externí volání ven z aplikace ---
AGT --> LLM
CC --> CRM
RAG --> QD
DBS --> PG
DBM --> PG

' --- Poznámky (přesunuty dolů, aby nerozšiřovaly plátno) ---
note bottom of QA
  quick_actions:
  experimentální větev
  bez LLM.
end note

note bottom of QD
  1 Qdrant kolekce
  per tenant
end note

@enduml