' ============================================================
' DIAGRAM 4 — CRM Write Service & Confirmation Flow
' ============================================================
@startuml diagram_4_write_service
!theme plain
skinparam defaultFontSize 12
skinparam ArrowColor #555
skinparam BackgroundColor #FAFAFA
skinparam NoteBackgroundColor #FFFDE7
skinparam NoteBorderColor #F9A825

title [4] CRM Write Service & Confirmation Flow\napp/services/crm_write_service.py

start

:execute_action(module, action, data_json);

:Parse data_json -> dict;
:Infer effective_module from intent/context;

partition "ModuleAdjustmentEngine" {
  :Apply field defaults\n(e.g., duration, status);
  :Resolve entity references\nvia EntityResolver;
  :Build adjustments notes list;
}

if (mutation action?) then (yes)
  if (action_confirmation = true?) then (confirmed)
    #LightGreen:EXECUTE;
    :SugarClient.execute_module_action()\n-> HTTP to Coripo API (HMAC signed);
    if (success?) then (yes)
      :TenantRAGService.ingest_from_crm()\n(update vector index);
      :Return result + adjustments metadata;
    else (error)
      :Return error response;
    endif
  else (not confirmed)
    #FFB300:HOLD FOR CONFIRMATION;
    :build_pending_action_envelope();
    note right
      envelope = {
        module, action, data,
        adjustments, ambiguities,
        requires_confirmation: true
      }
    end note
    :Return {
      status: "confirmation_required",
      pending_action: envelope,
      message: "Akce meni CRM data..."
    };
    note right
      Stored in ChatMessage.metadata.
      Executed on NEXT turn when
      user confirms with confirm_action=true.
    end note
  endif
else (read only)
  :Pass through to CRMReadService;
endif

stop
@enduml


' ============================================================
' DIAGRAM 5 — Entity Resolver Flow
' ============================================================
@startuml diagram_5_entity_resolver
!theme plain
skinparam defaultFontSize 12
skinparam ArrowColor #555
skinparam BackgroundColor #FAFAFA
skinparam NoteBackgroundColor #FFFDE7
skinparam NoteBorderColor #F9A825

title [5] Entity Resolver Flow\napp/domain/entity_resolver.py

start

:resolve_record_by_name(scope, name, for_mutation);
note right
  scope: "contacts" or "accounts"
  for_mutation: affects threshold used
end note

partition "Expand Name Variants" {
  :expand_name_variants(name);
  note right
    Czech-aware expansion:
    - Remove diacritics (Zliner -> Zliner)
    - Tokenize + combinations (up to 16)
    - Handle compound names
  end note
}

partition "Search CRM" {
  while (more variants?) is (yes)
    :SugarClient.generic_search(variant, scope);
    if (results empty?) then (yes)
      :Fallback: execute_module_action(module, "list")\nfilter: name contains variant;
    endif
    :Collect all candidate records;
  endwhile (done)
}

partition "Score Candidates" {
  :Deduplicate by record_id\n(keep highest score per record);
  note right
    Scoring:
    100 = exact match (normalized)
     80 = substring match
     60 * overlap_ratio = token overlap
     85 max = SequenceMatcher >= 0.72
  end note
  :Sort by score descending;
}

partition "Resolution Decision" {
  :top_score, second_score from top two;
  :confidence = top_score / 100;
  :gap = confidence - (second_score / 100);

  if (for_mutation?) then (yes)
    :threshold = mutation_confidence_threshold (0.70);
  else (read)
    :threshold = read_confidence_threshold (0.70);
  endif

  if (confidence >= threshold\nAND gap >= ambiguity_gap (0.08)?) then (yes)
    #LightGreen:RESOLVED;
    :Return EntityResolution(\n  status="resolved",\n  selected=top_record,\n  confidence=confidence\n);
  else (no)
    #FFB300:AMBIGUOUS;
    :Return EntityResolution(\n  status="ambiguous",\n  candidates=top_5,\n  reason="low confidence or too close"\n);
    note right
      Ambiguous result triggers pending_action
      with ambiguities list.
      User must disambiguate before mutation.
    end note
  endif
}

stop
@enduml


' ============================================================
' DIAGRAM 6 — Multi-Tenancy & Auth Flow
' ============================================================
@startuml diagram_6_multitenancy
!theme plain
skinparam defaultFontSize 12
skinparam ArrowColor #555
skinparam BackgroundColor #FAFAFA
skinparam NoteBackgroundColor #FFFDE7
skinparam NoteBorderColor #F9A825

title [6] Multi-Tenancy & Auth Flow\napp/api/dependencies.py + app/services/tenant_manager.py

start

partition "Header Extraction" {
  :Read X-Tenant-Id header;
  :Read X-User-Id header;
  :Read Authorization header (optional HMAC);
}

partition "Tenant Resolution" {
  :TenantManager.get_credentials(tenant_id)\n(LRU cached);
  :SQL: SELECT Tenant WHERE id=tenant_id AND active=true;
  :decrypt_tenant_secret(crm_token_encrypted)\n-> Fernet symmetric decryption;

  if (JSON blob?) then (yes)
    :Parse: hmac_key_id, hmac_secret,\nsession_id, user_id;
  elseif (UUID?) then (yes)
    :Use as session_id\n(coripo_public mode);
  elseif ("key:secret"?) then (yes)
    :Split for HMAC auth;
  else (plain string)
    :Use as HMAC secret;
  endif
}

partition "Scoped Initialization" {
  :Init SugarClient(base_url, token, user_id)\n-> tenant-specific CRM HTTP client;
  :Init TenantRAGService\n-> Qdrant collection: {prefix}_{tenant_id_sanitized};
  :All DB queries filtered by tenant_id + user_id;
  note right
    Tenant isolation:
    DB:  all queries scoped by tenant_id
    CRM: separate credentials per tenant
    RAG: separate Qdrant collection per tenant
    Log: all ops tagged with tenant_id
  end note
}

:Return TenantContext\n{tenant_id, user_id, crm_client, rag_service};

stop
@enduml


' ============================================================
' DIAGRAM 7 — Pending Action State Machine
' ============================================================
@startuml diagram_7_pending_action_states
!theme plain
skinparam defaultFontSize 12
skinparam ArrowColor #555
skinparam BackgroundColor #FAFAFA
skinparam NoteBackgroundColor #FFFDE7
skinparam NoteBorderColor #F9A825
skinparam StateBackgroundColor #EEF
skinparam StateBorderColor #669

title [7] Pending Action Confirmation State Machine

[*] --> Idle

Idle --> Processing : User sends request

Processing --> NoPending : No prior pending action in DB
Processing --> HasPending : Load pending_action from DB

NoPending --> Routing
HasPending --> PatchFlow : confirm_action=true\nOR non-readonly query
HasPending --> ReadFlow : Read-only query

Routing --> QuickAction : Czech regex matches
Routing --> AgentLoop : No quick action match

QuickAction --> ConfirmRequired : Mutation without action_confirmation
QuickAction --> Done : Read-only or confirmed

AgentLoop --> ConfirmRequired : crm_action_tool called\nwithout confirmation
AgentLoop --> Done : Read or confirmed mutation

ConfirmRequired --> PendingSaved : Store envelope in\nChatMessage.metadata

PendingSaved --> Idle : Await next user turn

PatchFlow --> PatchApplied : try_patch_pending_action()\nupdate slots from new input
PatchApplied --> Executed : execute_action(\naction_confirmation=true)
Executed --> Done

ReadFlow --> Done : Process read normally

Done --> [*]

note right of ConfirmRequired
  pending_action envelope:
  {module, action, data,
  adjustments, ambiguities,
  requires_confirmation: true}
end note

note right of PatchFlow
  User may refine the pending
  action by adding/changing
  contact name, date, etc.
end note
@enduml


' ============================================================
' DIAGRAM 8 — RAG Search & Ingestion Flow
' ============================================================
@startuml diagram_8_rag
!theme plain
skinparam defaultFontSize 12
skinparam ArrowColor #555
skinparam BackgroundColor #FAFAFA
skinparam NoteBackgroundColor #FFFDE7
skinparam NoteBorderColor #F9A825

title [8] RAG Search & Ingestion Flow\napp/engine/rag.py -- TenantRAGService

partition "Search Flow" {
  start
  :rag_search_tool(query, limit, module);
  :Get/create Qdrant collection\n"{prefix}_{sanitized_tenant_id}";
  :HashEmbedder.embed(query)\n-> 384-dim deterministic vector;
  note right
    Dev: deterministic hash embedder.
    Replace with real embedder in prod.
  end note
  :Qdrant.search_points(collection, vector, limit)\n-> cosine similarity ranking;
  :Return [{payload: {module, record}, score}]\nsorted by score descending;
  stop
}

partition "Ingestion Flow (triggered post-write)" {
  start
  :ingest_from_crm(tenant_id, crm_client, module);
  :Fetch records from CRM module;
  while (each record) is (next)
    :point_id = hash(record_id + module);
    :text = "{name} {description} {email} ...";
    :vector = HashEmbedder.embed(text);
    :Create Qdrant point {id, vector, payload};
  endwhile (done)
  :Batch upsert to Qdrant\n(batch_size=200);
  stop
}
@enduml
