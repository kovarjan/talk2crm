' ============================================================
' DIAGRAM 1 — Main Request Processing Flow
' ============================================================
@startuml diagram_1_request_flow
!theme plain
skinparam defaultFontSize 12
skinparam ArrowColor #555
skinparam BackgroundColor #FAFAFA
skinparam NoteBackgroundColor #FFFDE7
skinparam NoteBorderColor #F9A825

title [1] Main Request Processing Flow\nPOST /process-input/

start

:HTTP Request\n(input_text, chat_id, context, return_voice);

partition "Auth & Tenant Resolution" {
  :Extract headers\n(X-Tenant, X-User-Id, X-User-Name, Authorization...);
  if (Authorization starts with HMAC?) then (yes)
    :verify_hmac_request(method, path, body,\ntimestamp, nonce);
    if (signature valid?) then (yes)
    else (no)
      :401 Invalid HMAC signature;
      stop
    endif
  endif
  :TenantManager.assert_user_access(tenant_id, user_id);
}

partition "Service Initialization" {
  :TenantManager.get_credentials(tenant_id)\n-> decrypt_tenant_secret + token fallback logic;
  :Init CoripoClient(base_url, crm_token, user_id, user_name);
  :get_rag_service() (lazy singleton init);
}

partition "Chat & Context Loading" {
  :Load or create Chat (by chat_id);
  :Load latest pending_action from ChatMessage.metadata;
  :Load latest crm record-created event;
  :Merge incoming context + optional pending/context hints;
  :append user message into chat history;
}

partition "Execution Path Decision" {
  if (pending_action exists AND not confirm_action?) then (yes)
    :try_patch_pending_action(input_text, pending_action);
    if (patch produced result?) then (yes)
      :execution_mode = "pending_patch";
      :agent_result = patched confirmation_required payload;
    else (no)
      :continue routing;
    endif
  endif

  if (agent_result already produced?) then (yes)
  else (no)
    if (quick_action_enabled AND parser matched\ncreate_contact/create_meeting?) then (yes)
      :try_handle_quick_action(...);
      if (should_fallback = false?) then (yes)
        :execution_mode = "quick_action";
        :agent_result = quick action result;
      else (fallback)
        :execution_mode = "agent";
        :Build tools + run_agent(...);
      endif
    else (no)
      :execution_mode = "agent";
      :Build tools + run_agent(...);
    endif
  endif
}

partition "Response Finalization" {
  :Normalize agent result for UI;
  :Append assistant message (metadata: agent_result/raw_output);
  :Ensure chat name + DB commit;
  if (return_voice?) then (yes)
    :_maybe_generate_voice(...);
  endif
  :Return HTTP response\n(action_result, cards, chat_history, audio_url...);
}

stop
@enduml


' ============================================================
' DIAGRAM 2 — Agent Execution Loop
' ============================================================
@startuml diagram_2_agent_loop
!theme plain
skinparam defaultFontSize 12
skinparam ArrowColor #555
skinparam BackgroundColor #FAFAFA
skinparam NoteBackgroundColor #FFFDE7
skinparam NoteBorderColor #F9A825

title [2] Agent Execution Loop\napp/engine/agent.py -- run_agent()

start

:Build system prompt (Czech)\nwith date ranges + tool usage rules;
:Build human_text containing:\ninput + UI hint + context JSON + recent history;
:messages = [SystemMessage, HumanMessage];
:intermediate_steps = [];

note right
  Tools are not bound via function-calling schema.
  Model emits <tool_call>{json}</tool_call> and
  code parses tags manually.
end note

while (iteration < 6?) is (continue)
  :llm.ainvoke(messages) -> AIMessage;
  :Strip <think> tags;

  if (<tool_call> found?) then (yes)
    :Parse JSON (json.loads, fallback json_repair);
    if (valid JSON?) then (yes)
      :If args.data_json is object/list -> serialize to JSON string;
      :Invoke tool_obj.ainvoke(args) -> t_result;
      :Log + append intermediate_steps;
      if (tool result status == confirmation_required?) then (yes)
        :final_answer = message_to_user/message;
        break
      else (no)
        :Append AI message + Human observation\n("Pokračuj: zavolej další nástroj nebo dej <answer>");
      endif
    else (no)
      :Append correction prompt\n("Chyba JSON v tool_call...");
    endif
  elseif (<answer> found?) then (yes)
    :final_answer = answer content;
    break
  elseif (plain text without tags?) then (yes)
    :final_answer = content;
    break
  else (empty/thinking only)
    if (iteration < 2?) then (yes)
      :Append push prompt to call tool;
    else (no)
      break
    endif
  endif
endwhile (done)

if (final_answer empty?) then (yes)
  :Synthesize from last observation\n(message_to_user | summary | raw observation);
endif

:Return {output, intermediate_steps};
stop
@enduml


