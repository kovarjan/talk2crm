' ============================================================
' DIAGRAM 4 — CRM Write Service & Confirmation Flow
' ============================================================
@startuml diagram_4_write_service
!theme plain
skinparam defaultFontSize 12
skinparam ArrowColor #555
skinparam BackgroundColor #FAFAFA
skinparam NoteBackgroundColor #FFFDE7
skinparam NoteBorderColor #F9A825

title [4] CRM Write Service & Confirmation Flow\napp/services/crm_write_service.py

start

:execute_action(module, action, data_json);
:Parse data_json -> dict;
:Infer effective_module for create/update/patch;

partition "ModuleAdjustmentEngine" {
  :adjustment = apply(module, action, data);
  :data = adjustment.data;
  :notes = adjustment.notes;
}

if (action in create/update/patch/delete?) then (mutation)
  if (action_confirmation = false?) then (hold)
    :pending_action = build_pending_action_envelope(...);
    :Return {status:"confirmation_required",\npending_action, adjustments};
    stop
  else (confirmed)
  endif
endif

:data.requested_by_user_id = user_id;
:result = crm_client.execute_module_action(effective_module, action, data);

if (mutation AND rag_service available?) then (yes)
  :rag_service.ingest_from_crm(tenant_id, crm_client, module);
  :Attach _rag_ingested or _rag_ingest_error;
endif

if (httpx.HTTPStatusError?) then (yes)
  :Return crm_http_error with failed_action payload;
elseif (other exception?) then (yes)
  :Return crm_action_error with failed_action payload;
else (ok)
  :Return CRM result (+ _adjustments if present);
endif

stop
@enduml


' ============================================================
' DIAGRAM 5 — Entity Resolver Flow
' ============================================================
@startuml diagram_5_entity_resolver
!theme plain
skinparam defaultFontSize 12
skinparam ArrowColor #555
skinparam BackgroundColor #FAFAFA
skinparam NoteBackgroundColor #FFFDE7
skinparam NoteBorderColor #F9A825

title [5] Entity Resolver Flow\napp/domain/entity_resolver.py

start

:resolve_record_by_name(scope, name, for_mutation);
note right
  scope: contacts | accounts
  policy thresholds loaded from settings
end note

partition "Expand Name Variants" {
  :expand_name_variants(name);
  note right
    Czech-aware variants:
    - remove diacritics during normalization
    - token-level suffix heuristics
    - cap combinations (max 16)
  end note
}

partition "Search CRM" {
  while (more variants?) is (yes)
    :crm_client.generic_search(variant, scope);
    if (results empty?) then (yes)
      :Fallback list call with field filter\n(name/first_name/last_name contains variant);
    endif
    :Extract records + keep valid CRM IDs;
  endwhile (done)
}

partition "Score Candidates" {
  :Compute score per record:\n100 exact, 80 substring,\n60*token_overlap, SequenceMatcher boost;
  :Drop nameless/zero-score rows;
  :Deduplicate by record_id\n(keep highest score);
  :Sort descending;
}

partition "Resolution Decision" {
  :confidence = top_score / 100;
  :gap = top_confidence - second_confidence;
  :threshold = mutation or read threshold from policy;

  if (confidence >= threshold\nAND gap >= ambiguity_gap?) then (yes)
    :Return EntityResolution(status="resolved", selected=top);
  else (no)
    :Return EntityResolution(status="ambiguous", candidates=top_5,\nreason="below_threshold_or_gap");
  endif
}

stop
@enduml


' ============================================================
' DIAGRAM 6 — Multi-Tenancy & Auth Flow
' ============================================================
@startuml diagram_6_multitenancy
!theme plain
skinparam defaultFontSize 12
skinparam ArrowColor #555
skinparam BackgroundColor #FAFAFA
skinparam NoteBackgroundColor #FFFDE7
skinparam NoteBorderColor #F9A825

title [6] Multi-Tenancy & Auth Flow\napp/api/dependencies.py + app/services/tenant_manager.py

start

partition "Header Extraction" {
  :Read X-Tenant;
  :Read X-User-Id;
  :Read X-User-Name (optional);
  :Read Authorization + X-Timestamp + X-Nonce (optional HMAC);
}

partition "Request Auth Check" {
  if (Authorization starts with HMAC?) then (yes)
    :verify_hmac_request(...);
    if (valid?) then (yes)
    else (no)
      :401 Invalid HMAC signature;
      stop
    endif
  endif
  :TenantManager.assert_user_access(tenant_id, user_id);
}

partition "Tenant Credentials Resolution" {
  :SELECT tenant WHERE id=tenant_id AND active=true;
  :decrypt_tenant_secret(crm_token_encrypted);
  :_resolve_effective_crm_token(token)\n(may fallback to CORIPO_TEST_TOKEN);
}

partition "Scoped Initialization (in endpoint core)" {
  :Init CoripoClient(base_url, token, user_id, user_name);
  :Optionally init/get TenantRAGService singleton;
  note right
    Isolation model:
    - SQL queries scoped by tenant_id + user_id
    - CRM creds stored per tenant
    - RAG collection per tenant:
      <qdrant_collection_prefix>__<tenant_sanitized>
  end note
}

:Return TenantContext\n{tenant_id, user_id, user_name};

stop
@enduml


' ============================================================
' DIAGRAM 7 — Pending Action State Machine
' ============================================================
@startuml diagram_7_pending_action_states
!theme plain
skinparam defaultFontSize 12
skinparam ArrowColor #555
skinparam BackgroundColor #FAFAFA
skinparam NoteBackgroundColor #FFFDE7
skinparam NoteBorderColor #F9A825
skinparam StateBackgroundColor #EEF
skinparam StateBorderColor #669

title [7] Pending Action Confirmation State Machine

[*] --> Idle
Idle --> Processing : user request

Processing --> PendingLoaded : load latest pending_action

PendingLoaded --> PatchAttempt : pending exists AND not confirm_action
PatchAttempt --> Patched : try_patch_pending_action() returned payload
PatchAttempt --> Routing : no patch produced
PendingLoaded --> Routing : no pending OR confirm_action=true

Patched --> ConfirmRequired : status=confirmation_required

Routing --> QuickAction : quick-action parser matched
Routing --> AgentLoop : no quick-action match

QuickAction --> QuickDone : should_fallback=false
QuickAction --> AgentLoop : should_fallback=true

AgentLoop --> ConfirmRequired : crm_action_tool returned confirmation_required
AgentLoop --> Done : final answer produced

ConfirmRequired --> PendingSaved : envelope persisted in assistant metadata
PendingSaved --> Done

QuickDone --> Done
Done --> [*]

note right of ConfirmRequired
  pending_action envelope:
  {module, action, data,
   adjustments, ambiguities,
   requires_confirmation:true}
end note

note right of PatchAttempt
  Patch helper can update pending fields
  (datetime/duration/description)
  and reissue confirmation text.
end note
@enduml


' ============================================================
' DIAGRAM 8 — RAG Search & Ingestion Flow
' ============================================================
@startuml diagram_8_rag
!theme plain
skinparam defaultFontSize 12
skinparam ArrowColor #555
skinparam BackgroundColor #FAFAFA
skinparam NoteBackgroundColor #FFFDE7
skinparam NoteBorderColor #F9A825

title [8] RAG Search & Ingestion Flow\napp/engine/rag.py -- TenantRAGService

partition "Search Flow" {
  start
  :rag_search_tool(query, limit, module);
  :Resolve tenant collection\n"<prefix>__<tenant_sanitized>";

  :Text pass: Qdrant scroll with MatchText\n(filter key="text", query text);
  :Vector pass:\nembed(query) via OllamaEmbedder (/embeddings)\nwith HashEmbedder fallback;
  :Qdrant search/query_points cosine similarity;
  :Merge results: text hits first, then vector hits\n(deduplicate by point id, cap by limit);
  :Return [{payload: {module, record, ...}, score}];
  stop
}

partition "Ingestion Flow" {
  start
  :Trigger sources:\n- POST /rag/ingest/ (sync/background)\n- post-mutation refresh from CRMWriteService;
  :ingest_from_crm_paginated(tenant_id, module, incremental);
  :watermark = latest modified_at in tenant+module (if incremental);

  while (page from CRM list API) is (next)
    :Fetch records (offset/max_results/include_hash);
    :Select records with modified_at >= watermark\n(keep unknown timestamps);
    :For each selected record:\npoint_id = uuid5("tenant:module:record_id");
    :text = cleaned json.dumps(record);
    :record_hash compare with existing payload hash;
    if (hash changed?) then (yes)
      :vector = aembed(text);
      :Upsert point payload {tenant_id,module,record_id,\nrecord_hash,modified_at,text,record};
    else (no)
      :skip unchanged;
    endif
  endwhile (done)

  :Batch upsert (rag_upsert_batch_size, default 200);
  stop
}
@enduml
