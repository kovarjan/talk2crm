' ============================================================
' DIAGRAM 1 — Main Request Processing Flow
' ============================================================
@startuml diagram_1_request_flow
!theme plain
skinparam defaultFontSize 12
skinparam ArrowColor #555
skinparam BackgroundColor #FAFAFA
skinparam NoteBackgroundColor #FFFDE7
skinparam NoteBorderColor #F9A825

title [1] Main Request Processing Flow\nPOST /process-input/

start

:HTTP Request\n(input_text, chat_id, context, return_voice);

partition "Auth & Tenant Resolution" {
  :Extract headers\n(X-Tenant, X-User-Id, Authorization);
  :TenantManager.get_credentials(tenant_id)\n-> decrypt crm_token;
  :Init SugarClient + TenantRAGService;
}

partition "Chat & State Loading" {
  :Load or create Chat (by chat_id);
  :Load latest pending_action\nfrom last assistant ChatMessage;
  note right
    pending_action stored in
    ChatMessage.metadata JSON
  end note
}

partition "Execution Path Decision" {
  if (pending_action exists?) then (yes)
    if (confirm_action=true\nOR non-readonly query?) then (yes)
      :merge_context_with_pending_action()\n(add entity hints to context);
      :execution_mode = "pending_patch";
      :try_patch_pending_action(input_text, pending_action)\n-> update slots from new input;
    else (no)
      :treat as new query;
    endif
  else (no)
  endif

  if (try_handle_quick_action(input_text)?) then (matched)
    #LightGreen:QUICK ACTION PATH;
    :CommandParser.parse(input_text)\n-> NormalizedCommand;
    :CRMWriteService.execute_quick_command(command);
    note right
      Bypasses LLM entirely.
      Czech regex patterns match
      "create_contact", "create_meeting",
      "latest_leads", "week_meetings"
    end note
    if (action_confirmation?) then (no)
      :Build pending_action_envelope;
      :Return confirmation_required response;
      stop
    else (yes)
      :Execute CRM mutation;
    endif
  else (no match)
    #LightBlue:AGENT PATH;
    :run_agent(input_text, chat_history, tools, context);
  endif
}

partition "Response Finalization" {
  :Normalize result for UI\n(format cards, links, pending_action);
  :Persist Chat + ChatMessage to DB;
  if (return_voice?) then (yes)
    :edge-tts voice synthesis;
  endif
  :Return HTTP Response;
}

stop
@enduml


' ============================================================
' DIAGRAM 2 — LangChain Agent Execution Loop
' ============================================================
@startuml diagram_2_agent_loop
!theme plain
skinparam defaultFontSize 12
skinparam ArrowColor #555
skinparam BackgroundColor #FAFAFA
skinparam NoteBackgroundColor #FFFDE7
skinparam NoteBorderColor #F9A825

title [2] LangChain Agent Execution Loop\napp/engine/agent.py -- run_agent()

start

:Build system prompt (Czech)\nwith date context (today/tomorrow/this_week/next_week);
:Assemble messages:\n[SystemMessage, ...chat_history, HumanMessage(input)];

note right
  System prompt includes:
  - Current date/time context
  - Available tools list with examples
  - "Always call a tool. Never answer from memory."
end note

:iteration = 0, empty_count = 0;

while (iteration < 6?) is (continue)
  :Chat.ainvoke(messages)\n-> AIMessage response;
  :OllamaPayloadCallback logs\nfull payload to ollama_chat.log;

  if (<tool_call>...</tool_call> found?) then (yes)
    :Extract tool name + args JSON;
    :Validate args via tool_validator;
    if (valid?) then (yes)
      :Lookup tool in tools_by_name dict;
      :await tool_obj.ainvoke(args)\n-> observation string;
      :Append AIMessage(tool_call) +\nHumanMessage(observation) to messages;
      :Log LLM_STEP_TOOL_RESULT;
      :iteration++;
    else (no)
      :Append validation error as observation;
      :iteration++;
    endif
  elseif (<answer>...</answer> found?) then (yes)
    :Extract final_answer;
    break
  elseif (plain text, no tags?) then (yes)
    :Use as final_answer;
    break
  else (empty response)
    :empty_count++;
    if (empty_count < 2?) then (yes)
      :Append push prompt:\n"Zavolej nyni prislusny nastroj...";
    else (no)
      break
    endif
  endif
endwhile (max iterations reached)

if (final_answer empty?) then (yes)
  :Synthesize from last tool observation;
endif

:Return {output, intermediate_steps};
note right
  intermediate_steps = list of:
  {tool, tool_input, observation}
end note

stop
@enduml


