APP_NAME=talk2crm AI Bridge
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production
INSTALL_GPU_DEPS=true
PIP_TIMEOUT=120
PIP_RETRIES=10
LOG_FORMAT=json
LOG_FORCE_COLOR=false
LOG_FILE_ENABLED=true
LOG_FILE_PATH=./logs/talk2crm.log
LOG_FILE_FORMAT=json
# Logs contain message bodies / CRM payloads (PII): keep both off in production.
# When enabled, bodies are redacted to sizes unless LOG_INCLUDE_PAYLOADS=true (debug only).
CRM_WIRE_LOG_ENABLED=false
CRM_WIRE_LOG_PATH=./logs/crm_wire.log
CRM_WIRE_LOG_FORMAT=pretty
LOG_TRACE_ENABLED=false
LOG_INCLUDE_PAYLOADS=false
LOG_TRACE_MAX_CHARS=1200
LOG_TRACE_HISTORY_MESSAGES=10

POSTGRES_DB=talk2crm
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password

# Used by the app directly when not running in compose.
DATABASE_URL=postgresql+asyncpg://postgres:change-me-strong-password@postgres:5432/talk2crm

LLM_BASE_URL=http://your-llm-host:11434/v1
LLM_MODEL=qwen3:latest
LLM_API_KEY=EMPTY
LLM_TEMPERATURE=0.1
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1
# Tool-call rounds per chat turn before the agent must answer (default 10)
AGENT_MAX_ITERATIONS=10
# Wall-clock budget for one whole agent turn (all LLM/tool iterations).
AGENT_TURN_TIMEOUT_SECONDS=180

QDRANT_URL=http://qdrant:6333
# Required: docker-compose.prod.yml refuses to start without it.
QDRANT_API_KEY=change-me-long-random-key
QDRANT_COLLECTION=tenant_knowledge
# Must match the embedding model's output dimension (qwen3-embedding:4b = 2560).
RAG_EMBEDDING_MODEL=qwen3-embedding:4b
RAG_EMBEDDING_SIZE=2560
# Set true only to allow a silent local-disk Qdrant fallback (off in production).
QDRANT_ALLOW_LOCAL_FALLBACK=false

CACHE_DIR=./cache

WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=auto
WHISPER_ALLOW_CPU_FALLBACK=true

TTS_PROVIDER=edge-tts
TTS_VOICE=cs-CZ-VlastaNeural

CRM_MODE=on
CRM_TIMEOUT_SECONDS=25
# Per-tenant HMAC keys live (encrypted) in the DB: python scripts/onboard_tenant.py
HMAC_MAX_SKEW_SECONDS=300
# Startup is refused in production unless REQUIRE_HMAC=true and CORS origins are explicit.
REQUIRE_HMAC=true
# Bind X-Tenant, X-User-Id and the query string into the signed string. Both sides must be
# upgraded together: the CRM client must sign
#   METHOD\nPATH\nTIMESTAMP\nNONCE\nQUERY\nTENANT\nUSER_ID\nBODY
# Roll out: deploy gateway with false (accepts both formats) -> upgrade client -> set true.
HMAC_BIND_IDENTITY=false
# Replay protection store: auto = shared database store outside dev/test (needed with >1 worker).
HMAC_NONCE_STORE=auto
# Comma list of user ids ("user" or "tenant:user") that may manage tenant-scope skills.
# Empty = nobody (tenant skill write/approve/deactivate return 403).
SKILLS_ADMIN_USER_IDS=

# Audio uploads
AUDIO_MAX_UPLOAD_BYTES=26214400
AUDIO_MAX_CONCURRENT_TRANSCRIPTIONS=2
TENANT_SECRET_KEY="CHANGE_ME_WITH_32_BYTE_URLSAFE_BASE64_FOR_FERNET"

# Restrict in production (comma-separated or JSON list)
CORS_ALLOW_ORIGINS=["https://your-domain.example"]
# Optional: allow a whole family of instances (full match against the Origin header)
# CORS_ALLOW_ORIGIN_REGEX=https://([a-z0-9-]+\.)*coripo\.(app|cloud|dev)

# API process tuning
UVICORN_WORKERS=2
# Proxy IPs trusted for X-Forwarded-* (set to your reverse proxy / docker network gateway).
FORWARDED_ALLOW_IPS=127.0.0.1
# Migrations run in the one-shot `migrate` service; workers skip them.
RUN_MIGRATIONS_ON_STARTUP=false
AGGREGATE_TOOLS_ENABLED=true

# Docker/NVIDIA runtime for GPU
DOCKER_GPUS=all
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility
