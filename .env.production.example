APP_NAME=talk2crm AI Bridge
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production
INSTALL_GPU_DEPS=true
PIP_TIMEOUT=120
PIP_RETRIES=10
LOG_FORMAT=json
LOG_FORCE_COLOR=false
LOG_FILE_ENABLED=true
LOG_FILE_PATH=./logs/talk2crm.log
LOG_FILE_FORMAT=json
LOG_TRACE_ENABLED=true
LOG_TRACE_MAX_CHARS=1200
LOG_TRACE_HISTORY_MESSAGES=10

POSTGRES_DB=talk2crm
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password

# Used by the app directly when not running in compose.
DATABASE_URL=postgresql+asyncpg://postgres:change-me-strong-password@postgres:5432/talk2crm

LLM_BASE_URL=http://your-llm-host:11434/v1
LLM_MODEL=qwen3:latest
LLM_API_KEY=EMPTY
LLM_TEMPERATURE=0.1

QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=tenant_knowledge
RAG_EMBEDDING_SIZE=384

CACHE_DIR=./cache

WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=auto
WHISPER_ALLOW_CPU_FALLBACK=true

TTS_PROVIDER=edge-tts
TTS_VOICE=cs-CZ-VlastaNeural

CRM_MODE=on
CRM_TIMEOUT_SECONDS=25
CORIPO_HMAC_KEY_ID=acmark-ai

HMAC_KEYS_JSON={"acmark-ai":"replace-with-hmac-secret"}
HMAC_MAX_SKEW_SECONDS=300
TENANT_SECRET_KEY="CHANGE_ME_WITH_32_BYTE_URLSAFE_BASE64_FOR_FERNET"

# Restrict in production (comma-separated or JSON list)
CORS_ALLOW_ORIGINS=["https://your-domain.example"]

# API process tuning
UVICORN_WORKERS=2

# Docker/NVIDIA runtime for GPU
DOCKER_GPUS=all
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility
