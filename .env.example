# Core models
# WHISPER_MODEL: Whisper model name
WHISPER_MODEL=small
# TTS_MODEL: TTS model name
TTS_MODEL=tts_models/multilingual/multi-dataset/xtts_v2
# TTS_METHOD: TTS backend
TTS_METHOD=xtts
# TTS_DEVICE: auto/cpu/cuda
TTS_DEVICE=auto

# LLM
# LLM_API_URL: API endpoint for LLM completions
LLM_API_URL=http://localhost:11434/v1/chat/completions
# LLM_MODEL_NAME: model identifier
LLM_MODEL_NAME=qwen2.5:14b-instruct
# LLM_TEMPERATURE: float temperature
LLM_TEMPERATURE=0.6
# SHOW_TIMING: enable timing logs
SHOW_TIMING=false
# DEBUG_LLM: enable LLM debug logs
DEBUG_LLM=false
# DISABLE_REASONING: disable reasoning output
DISABLE_REASONING=false

# CRM
# CRM_SYSTEM: CRM adapter key
CRM_SYSTEM=coripo
# CRM_INSTANCE: CRM instance/tenant name
CRM_INSTANCE=Acmark
# CRM_EXECUTION_MODE: off|gateway|direct
CRM_EXECUTION_MODE=off
# CRM_DIRECT_BACKEND: coripo|sugar_v4_1 (used when CRM_EXECUTION_MODE=direct)
CRM_DIRECT_BACKEND=coripo

# Storage
# REDIS_URL: Redis connection string
REDIS_URL=redis://localhost:6379/0
# CHAT_KEY_PREFIX: Redis key prefix for chat history
CHAT_KEY_PREFIX=chat:
# CHAT_USER_INDEX_PREFIX: Redis key prefix for user index
CHAT_USER_INDEX_PREFIX=chat_user:
# CHAT_META_PREFIX: Redis key prefix for chat metadata
CHAT_META_PREFIX=chat_meta:
# CHAT_TTL_SECONDS: TTL for chat data in seconds
CHAT_TTL_SECONDS=604800

# Vector search/tool defaults
# DEFAULT_TENANT: default tenant fallback for tools
DEFAULT_TENANT=ai-local
# VECTOR_TOP_K: default top_k for vector search
VECTOR_TOP_K=5

# App
# CACHE_DIR: local cache directory
CACHE_DIR=cache
