APP_NAME=SugarVoice AI Bridge
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=dev
INSTALL_GPU_DEPS=false
PIP_TIMEOUT=120
PIP_RETRIES=10
LOG_FORMAT=pretty
LOG_FILE_ENABLED=false
LOG_FILE_PATH=./logs/talk2api2.log
LOG_FILE_FORMAT=json
LOG_TRACE_ENABLED=true
LOG_TRACE_MAX_CHARS=1200
LOG_TRACE_HISTORY_MESSAGES=10

# Use PostgreSQL in production, SQLite works for local quick start.
DATABASE_URL=sqlite+aiosqlite:///./sugar_voice_bridge.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sugar_voice_bridge
# Docker compose (API container): DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/sugar_voice_bridge

# PosrtgreSQL
POSTGRES_DB=talk2crm
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Ollama OpenAI-compatible endpoint on dev server
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:latest
LLM_API_KEY=EMPTY
LLM_TEMPERATURE=0.1

QDRANT_URL=http://localhost:6333
# Docker compose (API container): QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=tenant_knowledge
RAG_EMBEDDING_SIZE=384

CACHE_DIR=./cache

WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
WHISPER_ALLOW_CPU_FALLBACK=true

TTS_PROVIDER=edge-tts
TTS_VOICE=cs-CZ-VlastaNeural

CRM_MODE=on
CRM_TIMEOUT_SECONDS=25
CORIPO_HMAC_KEY_ID=acmark-ai

# JSON mapping of keyId -> secret for optional HMAC request validation.
HMAC_KEYS_JSON={"acmark-ai":"replace-with-hmac-secret"}
HMAC_MAX_SKEW_SECONDS=300

# Use a strong random key in production.
TENANT_SECRET_KEY=replace-with-strong-secret-or-fernet-key

CORS_ALLOW_ORIGINS=["*"]
