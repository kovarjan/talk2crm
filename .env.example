APP_NAME=talk2crm AI Bridge
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=dev
INSTALL_GPU_DEPS=false
PIP_TIMEOUT=120
PIP_RETRIES=10
LOG_FORMAT=pretty
LOG_FORCE_COLOR=true
LOG_FILE_ENABLED=false
LOG_FILE_PATH=./logs/talk2crm.log
LOG_FILE_FORMAT=json
LOG_TRACE_ENABLED=true
LOG_TRACE_MAX_CHARS=1200
LOG_TRACE_HISTORY_MESSAGES=10

# PostgreSQL only.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/talk2crm
# Docker compose (API container): DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/talk2crm

# PostgreSQL
POSTGRES_DB=talk2crm
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Ollama OpenAI-compatible endpoint on dev server
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:latest
LLM_API_KEY=EMPTY
LLM_TEMPERATURE=0.1
LLM_CONTEXT_WINDOW_TOKENS=32768

QDRANT_URL=http://localhost:6333
# Docker compose (API container): QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=tenant_knowledge
RAG_EMBEDDING_SIZE=384

CACHE_DIR=./cache

WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
WHISPER_ALLOW_CPU_FALLBACK=true

TTS_PROVIDER=edge-tts
TTS_VOICE=cs-CZ-VlastaNeural

CRM_MODE=on
CRM_TIMEOUT_SECONDS=25
CORIPO_HMAC_KEY_ID=your-tenant-id

# JSON mapping of keyId -> secret for optional HMAC request validation.
HMAC_KEYS_JSON={"your-tenant-id":"replace-with-hmac-secret"}
HMAC_MAX_SKEW_SECONDS=300

# CRM tokens are encryped in DB with this key:
# Use a strong random key in production.
TENANT_SECRET_KEY="CHANGE_ME_WITH_32_BYTE_URLSAFE_BASE64_FOR_FERNET"

CORS_ALLOW_ORIGINS=["*"]

QUICK_ACTION_ENABLED=true          # master switch
QUICK_ACTION_MIN_CONFIDENCE=1.0          # default effectively disables regex (0.95) until you lower it
QUICK_ACTION_FALLBACK_ON_NO_CANDIDATES=true
QUICK_ACTION_FALLBACK_ON_AMBIGUOUS=true
QUICK_ACTION_FALLBACK_ON_EXCEPTION=true

RAG_EMBEDDING_MODEL=qwen3-embedding:4b
RAG_EMBEDDING_BASE_URL=http://localhost:11434/v1
RAG_EMBEDDING_SIZE=2560
